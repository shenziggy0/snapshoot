{
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devPath": "http://localhost:1420",
        "distDir": "../dist",
        "withGlobalTauri": false
    },
    "package": {
        "productName": "Snapshoot",
        "version": "1.2.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "shell": {
                "open": "^(https?://|file://|[A-Za-z]:[\\\\/]|/).+"
            },
            "path": {
                "all": true
            },
            "window": {
                "all": true
            },
            "clipboard": {
                "all": true
            },
            "globalShortcut": {
                "all": true
            },
            "notification": {
                "all": true
            },
            "http": {
                "request": true,
                "scope": [
                    "http://**",
                    "https://**"
                ]
            },
            "os": {
                "all": true
            },
            "protocol": {
                "asset": true,
                "assetScope": [
                    "$CACHE/**",
                    "$CONFIG/**",
                    "$APPCACHE/**"
                ]
            },
            "fs": {
                "readFile": true,
                "readDir": true,
                "exists": true,
                "removeDir": true,
                "scope": [
                    "$APPCONFIG/**",
                    "$APPCACHE/**"
                ]
            },
            "dialog": {
                "open": true,
                "save": true
            }
        },
        "bundle": {
            "active": true,
            "category": "Utility",
            "copyright": "GPLv3",
            "targets": "all",
            "identifier": "top.shenziggy.snapshoot",
            "longDescription": "Snapshoot is a cross-platform screenshot, pin, OCR, and translation app based on Pot (GPL-3.0).",
            "shortDescription": "Snapshoot",
            "externalBin": [],
            "resources": [],
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ],
            "deb": {
                "depends": [
                    "libxdo-dev",
                    "libxcb1",
                    "libxrandr2",
                    "tesseract-ocr"
                ]
            },
            "rpm": {
                "depends": [
                    "libxdo-dev",
                    "libxcb1",
                    "libxrandr2",
                    "tesseract-ocr"
                ]
            },
            "macOS": {
                "entitlements": null,
                "exceptionDomain": "",
                "frameworks": [],
                "providerShortName": null,
                "signingIdentity": null
            }
        },
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https://asset.localhost http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; media-src 'self' asset: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:*",
            "devCsp": "default-src 'self' http://localhost:1420; script-src 'self' 'unsafe-eval' http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https://asset.localhost http://asset.localhost http://localhost:1420; font-src 'self' data:; worker-src 'self' blob:; media-src 'self' asset: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:1420"
        },
        "windows": [
            {
                "title": "Daemon",
                "label": "daemon",
                "visible": false,
                "url": "daemon.html"
            }
        ],
        "macOSPrivateApi": true,
        "systemTray": {
            "iconPath": "icons/icon.png",
            "iconAsTemplate": true
        }
    }
}